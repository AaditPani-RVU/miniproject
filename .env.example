# Copy to .env and edit.

# --- Generator: "gguf" (local AgriParam via llama.cpp/Metal) | "openai" (any OpenAI-compatible server) | "extractive" (no LLM)
LLM_BACKEND=gguf
GGUF_REPO=arunmcops/AgriParam-GGUF
GGUF_FILE=AgriParam-Q4_K_M.gguf
# set to a local path to skip the HF download
GGUF_PATH=
N_CTX=2048

# openai backend (e.g. llama-server, Ollama, vLLM)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=none
OPENAI_MODEL=agriparam

# --- Translation: "none" (Hindi/English only) | "indictrans2" (adds Odia, Kannada, Tamil, ...)
TRANSLATOR=none
IT2_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
IT2_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M

# --- Retrieval
EMBED_MODEL=intfloat/multilingual-e5-small
TOP_K=3
# cosine score of best chunk below this -> answer "I don't know". e5 scores are compressed, tune with the eval script.
MIN_SCORE=0.80
